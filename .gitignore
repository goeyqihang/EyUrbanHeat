data/raw/*
!data/raw/.gitkeep
# GeoTIFFs written by notebooks/01_satellite_data_extraction.ipynb. They are up to
# ~160 MB each (GitHub rejects files over 100 MB); regenerate them with that notebook.
data/processed/*
!data/processed/.gitkeep
*.tif
*.tiff

